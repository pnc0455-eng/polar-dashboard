    function open(e){
      var inp = e.target;
      if (target === inp && pop) return;
      target = inp;
      var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(inp.value || '');
      var base = m ? new Date(Date.UTC(+m[1], +m[2]-1, +m[3])) : new Date();
      viewY = m ? +m[1] : base.getUTCFullYear();
      viewM = m ? +m[2]-1 : base.getUTCMonth();
      build();
    }
    document.addEventListener('click', function(e){
      if (pop && e.target.closest && e.target.closest('.jcdate-pop')){
        var nav = e.target.closest('[data-nav]');
        if (nav){ viewM += +nav.dataset.nav; if (viewM < 0){ viewM = 11; viewY--; } else if (viewM > 11){ viewM = 0; viewY++; } build(); return; }
        var cell = e.target.closest('[data-d]');
        if (cell){ setVal(cell.dataset.d); close(); return; }
        var act = e.target.closest('[data-act]');
        if (act){ if (act.dataset.act === 'clear') setVal(''); else { var n = new Date(); setVal(iso(n.getFullYear(), n.getMonth(), n.getDate())); } close(); return; }
        return;

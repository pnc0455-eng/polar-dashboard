  document.addEventListener('click', function(e){
    if (!document.documentElement.classList.contains('mobile-nav-open')) return;
    if (e.target.closest('.sidebar') || e.target.closest('#sbToggle')) return;
    document.documentElement.classList.remove('mobile-nav-open');
  });

  (function(){
    var link = document.querySelector('a.sidebar-item[href="/messages"]');
    if (!link) return;
    function check(){
      fetch('/api/messages/unread-count').then(function(r){ return r.json(); }).then(function(d){
        var existing = link.querySelector('.sidebar-unread-dot');
        if (d && d.ok && d.count > 0) { if (!existing) link.insertAdjacentHTML('beforeend', '<span class="sidebar-unread-dot" title="Unread messages"></span>'); }
        else if (existing) existing.remove();
      }).catch(function(){});
    }
    check();
    document.addEventListener('visibilitychange', function(){ if (!document.hidden) check(); });
  })();

  (function(){
    var cartLabel    = document.getElementById('topbarCartLabel');
    var creditsLabel = document.getElementById('topbarCreditsBal');
    if (!cartLabel && !creditsLabel) return;

    function refreshCart(){
      if (!cartLabel) return;
      fetch('/api/cart/count').then(function(r){ return r.json(); }).then(function(d){
        var n = (d && d.count) || 0;
        if (n > 0) { cartLabel.textContent = n + ' item' + (n !== 1 ? 's' : ''); cartLabel.style.display = 'inline'; }
        else { cartLabel.style.display = 'none'; }
      }).catch(function(){});
    }
    function refreshCredits(){
      if (!creditsLabel) return;
      fetch('/api/credits/balance').then(function(r){ return r.json(); }).then(function(d){
        creditsLabel.textContent = ((d && d.balance) || 0).toLocaleString();
      }).catch(function(){});
    }
    function refreshAll(){ refreshCart(); refreshCredits(); }

    refreshAll();
    window.addEventListener('focus', refreshAll);
    document.addEventListener('visibilitychange', function(){ if (!document.hidden) refreshAll(); });
    setInterval(refreshAll, 15000);
  })();

  window.dashToast = function(msg, ok){
    var t = document.getElementById('dashToast');
    if(!t){ t = document.createElement('div'); t.id='dashToast'; t.className='dash-toast'; document.body.appendChild(t); }
    var ic = ok===false
      ? '<img class="dt-ic" src="https://judahcustoms.org/assets/Emojis/x.png" style="width:16px;height:16px;object-fit:contain" alt="">'
      : (ok===true ? '<img class="dt-ic" src="https://judahcustoms.org/assets/Emojis/checkmark.png" style="width:16px;height:16px;object-fit:contain" alt="">' : '');
    t.innerHTML = ic + '<span></span>';
    t.lastChild.textContent = msg;
    t.classList.add('show');
    clearTimeout(window._dashT);
    window._dashT = setTimeout(function(){ t.classList.remove('show'); }, 2800);
  };

  window.dashConfirm = function(o){
    o = o || {};
    return new Promise(function(resolve){
      var ovl=document.createElement('div'); ovl.className='dash-ovl';
      var dlg=document.createElement('div'); dlg.className='dash-dlg';
      var t=document.createElement('div'); t.className='dash-dlg-t'; t.textContent=o.title||'Are you sure?';
      var b=document.createElement('div'); b.className='dash-dlg-b'; b.textContent=o.body||'';
      var a=document.createElement('div'); a.className='dash-dlg-a';
      var no=document.createElement('button'); no.className='dash-dlg-btn'; no.textContent=o.cancel||'Cancel';
      var go=document.createElement('button'); go.className='dash-dlg-btn go'+(o.danger?' danger':''); go.textContent=o.confirm||'Confirm';
      a.appendChild(no); a.appendChild(go);
      dlg.appendChild(t); if(o.body) dlg.appendChild(b); dlg.appendChild(a);
      ovl.appendChild(dlg); document.body.appendChild(ovl);
      requestAnimationFrame(function(){ ovl.classList.add('show'); go.focus(); });
      function done(v){ document.removeEventListener('keydown',key); ovl.classList.remove('show'); setTimeout(function(){ovl.remove();},170); resolve(v); }
      function key(e){ if(e.key==='Escape')done(false); if(e.key==='Enter')done(true); }
      document.addEventListener('keydown',key);
      no.onclick=function(){done(false)}; go.onclick=function(){done(true)};
      ovl.onclick=function(e){ if(e.target===ovl)done(false); };
    });
  };

  window.dashPrompt = function(o){
    o = o || {};
    return new Promise(function(resolve){
      var ovl=document.createElement('div'); ovl.className='dash-ovl';
      var dlg=document.createElement('div'); dlg.className='dash-dlg';
      var t=document.createElement('div'); t.className='dash-dlg-t'; t.textContent=o.title||'Enter a value';
      var ta=document.createElement('textarea');
      ta.style.cssText='width:100%;min-height:80px;margin-bottom:16px;padding:10px 12px;border-radius:10px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-size:13px;font-family:inherit;resize:vertical;line-height:1.5';
      ta.placeholder=o.placeholder||'';
      var a=document.createElement('div'); a.className='dash-dlg-a';
      var no=document.createElement('button'); no.className='dash-dlg-btn'; no.textContent=o.cancel||'Cancel';
      var go=document.createElement('button'); go.className='dash-dlg-btn go'+(o.danger?' danger':''); go.textContent=o.confirm||'Confirm';
      a.appendChild(no); a.appendChild(go);
      dlg.appendChild(t); dlg.appendChild(ta); dlg.appendChild(a);
      ovl.appendChild(dlg); document.body.appendChild(ovl);
      requestAnimationFrame(function(){ ovl.classList.add('show'); ta.focus(); });
      function done(v){ document.removeEventListener('keydown',key); ovl.classList.remove('show'); setTimeout(function(){ovl.remove();},170); resolve(v); }
      function key(e){ if(e.key==='Escape')done(null); }
      document.addEventListener('keydown',key);
      no.onclick=function(){done(null)}; go.onclick=function(){ if(o.required && !ta.value.trim()){ ta.style.borderColor='#ef4444'; return; } done(ta.value.trim()); };
      ovl.onclick=function(e){ if(e.target===ovl)done(null); };
    });
  };

  window.dashConfirmForm = function(e, opts){
    e.preventDefault();
    var form = e.target.closest('form');
    dashConfirm(opts).then(function(ok){ if(ok && form) form.submit(); });
    return false;
  };

  window.dashComposer = function(el, onSend){
    if(!el || el._composerBound) return; el._composerBound = true;
    function surround(pre, post){
      post = post==null ? pre : post;
      var s=el.selectionStart, e=el.selectionEnd, v=el.value, sel=v.slice(s,e);
      el.value = v.slice(0,s) + pre + sel + post + v.slice(e);
      el.selectionStart = s + pre.length; el.selectionEnd = e + pre.length;
      el.focus(); el.dispatchEvent(new Event('input'));
    }
    function insertLink(){
      var s=el.selectionStart, e=el.selectionEnd, v=el.value, sel=v.slice(s,e) || 'text';
      var ins='['+sel+'](url)'; el.value = v.slice(0,s) + ins + v.slice(e);
      var u = s + ins.lastIndexOf('url'); el.selectionStart=u; el.selectionEnd=u+3;
      el.focus(); el.dispatchEvent(new Event('input'));
    }
    el.addEventListener('keydown', function(ev){
      var mod = ev.ctrlKey || ev.metaKey;
      if(ev.key==='Enter'){
        if(mod || ev.shiftKey) return;      
        ev.preventDefault(); if(onSend) onSend(); return;
      }
      if(!mod) return;
      var k = (ev.key || '').toLowerCase();
      if(k==='b'){ ev.preventDefault(); surround('**'); }
      else if(k==='i'){ ev.preventDefault(); surround('*'); }
      else if(k==='u'){ ev.preventDefault(); surround('__'); }
      else if(k==='e'){ ev.preventDefault(); surround('`'); }
      else if(k==='k'){ ev.preventDefault(); insertLink(); }
      else if(ev.shiftKey && k==='x'){ ev.preventDefault(); surround('~~'); }
    });
  };

  window.dashCopy = function(text, label){
    if(text==null || text==='') return;
    navigator.clipboard.writeText(String(text))
      .then(function(){ if(window.dashToast) dashToast(label||'Copied', true); })
      .catch(function(){ if(window.dashToast) dashToast('Copy failed', false); });
  };

  window.dashContextMenu = function(ev, items){
    ev.preventDefault();
    var old=document.getElementById('dashCMenu'); if(old) old.remove();
    var menu=document.createElement('div'); menu.className='dash-cmenu'; menu.id='dashCMenu';
    function close(){ if(!menu.parentNode) return; menu.remove();
      document.removeEventListener('mousedown',onDoc,true); document.removeEventListener('keydown',onKey,true);
      window.removeEventListener('blur',close); window.removeEventListener('scroll',close,true); }
    items.forEach(function(it){
      if(!it) return;
      if(it.sep){ var s=document.createElement('div'); s.className='dash-cmi-sep'; menu.appendChild(s); return; }
      if(it.emojiRow){ var row=document.createElement('div'); row.className='dash-cmrow';
        it.emojiRow.forEach(function(e){ var b=document.createElement('button'); b.type='button'; b.className='dash-cmemoji'; b.textContent=e.label;
          b.onclick=function(){ close(); e.onClick&&e.onClick(); }; row.appendChild(b); });
        menu.appendChild(row); return; }
      var el=document.createElement('div'); el.className='dash-cmi'+(it.danger?' danger':'');
      var lbl=document.createElement('span'); lbl.textContent=it.label; el.appendChild(lbl);
      if(it.iconHtml){ var icH=document.createElement('span'); icH.className='ci'; icH.innerHTML=it.iconHtml; el.appendChild(icH); }
      else if(it.icon){ var ic=document.createElement('span'); ic.className='ci'; ic.textContent=it.icon; el.appendChild(ic); }
      el.onclick=function(){ close(); it.onClick&&it.onClick(); };
      menu.appendChild(el);
    });
    document.body.appendChild(menu);
    var mw=menu.offsetWidth, mh=menu.offsetHeight;
    menu.style.left=Math.max(6, Math.min(ev.clientX, window.innerWidth-mw-8))+'px';
    menu.style.top =Math.max(6, Math.min(ev.clientY, window.innerHeight-mh-8))+'px';
    requestAnimationFrame(function(){ menu.classList.add('show'); });
    function onDoc(e){ if(!menu.contains(e.target)) close(); }
    function onKey(e){ if(e.key==='Escape') close(); }
    setTimeout(function(){ document.addEventListener('mousedown',onDoc,true); document.addEventListener('keydown',onKey,true);
      window.addEventListener('blur',close); window.addEventListener('scroll',close,true); },0);
  };

  (function(){
    if (window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
    document.addEventListener('click', function(e){
      var a = e.target.closest('a');
      if (!a) return;
      var href = a.getAttribute('href');
      if (!href || href[0] === '#' || a.target === '_blank'
          || a.hasAttribute('download') || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      var url;
      try { url = new URL(a.href, location.href); } catch(_) { return; }
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.search === location.search) return;
      e.preventDefault();
      document.body.classList.add('pg-leaving');
      setTimeout(function(){ location.href = a.href; }, 150);
    });
    window.addEventListener('pageshow', function(){ document.body.classList.remove('pg-leaving'); });
  })();

  (function(){
    function enhance(sel){
      if (sel.dataset.jcdd || sel.dataset.native || sel.multiple || sel.size > 1) return;
      sel.dataset.jcdd = '1';
      var wrap = document.createElement('div');
      wrap.className = 'jcdd';
      var measured = sel.getBoundingClientRect().width;
      if (sel.style.width) wrap.style.width = sel.style.width;
      else if (measured > 10) wrap.style.width = measured + 'px';
      else wrap.style.width = '100%';
      if (sel.style.maxWidth) wrap.style.maxWidth = sel.style.maxWidth;

      var trig = document.createElement('button');
      trig.type = 'button';
      trig.className = sel.className + ' jcdd-trigger';
      trig.style.cssText = sel.style.cssText;   
      trig.style.width = '100%';
      trig.style.maxWidth = '';
      trig.innerHTML = '<span class="jcdd-label"></span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>';

      var menu = document.createElement('div');
      menu.className = 'jcdd-menu';
      menu.addEventListener('click', function(e){ e.stopPropagation(); });

      var searchIn = null;
      if (sel.options.length > 8) {
        searchIn = document.createElement('input');
        searchIn.className = 'jcdd-search';
        searchIn.placeholder = 'Search…';
        searchIn.addEventListener('click', function(e){ e.stopPropagation(); });
        searchIn.addEventListener('input', function(){
          var q = searchIn.value.trim().toLowerCase();
          Array.prototype.forEach.call(menu.querySelectorAll('.jcdd-opt'), function(o){
            o.style.display = !q || o.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
          });
        });
      }

      function syncLabel(){
        var op = sel.options[sel.selectedIndex];
        trig.querySelector('.jcdd-label').textContent = op ? op.textContent : '';
        Array.prototype.forEach.call(menu.querySelectorAll('.jcdd-opt'), function(c, i){ c.classList.toggle('sel', i === sel.selectedIndex); });
      }
      function rebuild(){
        menu.innerHTML = '';
        if (searchIn) menu.appendChild(searchIn);
        Array.prototype.forEach.call(sel.options, function(op, i){
          var o = document.createElement('button');
          o.type = 'button';
          o.className = 'jcdd-opt';
          o.textContent = op.textContent;
          o.addEventListener('click', function(){
            sel.selectedIndex = i;
            sel.dispatchEvent(new Event('change', { bubbles: true }));
            wrap.classList.remove('open');
          });
          menu.appendChild(o);
        });
        syncLabel();
      }
      trig.addEventListener('click', function(e){
        e.stopPropagation();
        var wasOpen = wrap.classList.contains('open');
        document.querySelectorAll('.jcdd.open').forEach(function(d){ d.classList.remove('open'); });
        if (!wasOpen) {
          var r = trig.getBoundingClientRect();
          var up = window.innerHeight - r.bottom < 280 && r.top > 280;
          wrap.classList.toggle('up', up);
          wrap.classList.add('open');
          menu.style.position = 'fixed';
          menu.style.left = r.left + 'px';
          menu.style.minWidth = r.width + 'px';
          if (up) { menu.style.top = ''; menu.style.bottom = (window.innerHeight - r.top + 6) + 'px'; }
          else    { menu.style.bottom = ''; menu.style.top = (r.bottom + 6) + 'px'; }
          if (searchIn) {
            searchIn.value = '';
            Array.prototype.forEach.call(menu.querySelectorAll('.jcdd-opt'), function(o){ o.style.display = ''; });
            setTimeout(function(){ searchIn.focus(); }, 0);
          }
        }
      });
      trig.addEventListener('keydown', function(e){
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          var d = e.key === 'ArrowDown' ? 1 : -1;
          sel.selectedIndex = Math.max(0, Math.min(sel.options.length - 1, sel.selectedIndex + d));
          sel.dispatchEvent(new Event('change', { bubbles: true }));
        } else if (e.key === 'Escape') wrap.classList.remove('open');
      });
      sel.addEventListener('change', syncLabel);

      sel.parentNode.insertBefore(wrap, sel);
      wrap.appendChild(trig);
      wrap.appendChild(menu);
      wrap.appendChild(sel);       
      sel.style.display = 'none';
      rebuild();
    }
    document.querySelectorAll('select').forEach(enhance);
    document.addEventListener('click', function(){
      document.querySelectorAll('.jcdd.open').forEach(function(d){ d.classList.remove('open'); });
    });
    window.addEventListener('scroll', function(e){
      if (e.target && e.target.closest && e.target.closest('.jcdd-menu')) return;
      document.querySelectorAll('.jcdd.open').forEach(function(d){ d.classList.remove('open'); });
    }, { capture: true, passive: true });
    new MutationObserver(function(muts){
      muts.forEach(function(m){
        Array.prototype.forEach.call(m.addedNodes, function(n){
          if (n.nodeType !== 1) return;
          if (n.tagName === 'SELECT') enhance(n);
          else if (n.querySelectorAll) Array.prototype.forEach.call(n.querySelectorAll('select'), enhance);
        });
      });
    }).observe(document.body, { childList: true, subtree: true });
  })();

  (function(){

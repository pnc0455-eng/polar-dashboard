<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Polar Follow</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@800&family=Inter:wght@400;600;700&display=swap');

        body {
            background-color: #060e1a;
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* --- Sidebar Menu Styles --- */
        .sidebar-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); z-index: 998; display: none;
        }
        .sidebar {
            position: fixed; top: 0; left: -260px; width: 260px; height: 100%;
            background: #0b1526; z-index: 999; transition: left 0.3s ease;
            box-shadow: 4px 0 15px rgba(0,0,0,0.5); padding-top: 0;
            border-right: 1px solid #1a2a42;
        }
        .sidebar.open { left: 0; }
        .sidebar-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 20px; border-bottom: 1px solid #1a2a42; background: #060e1a;
        }
        .sidebar-title { font-size: 18px; font-weight: bold; color: white; }
        .close-btn { width: 24px; height: 24px; fill: #8892b0; cursor: pointer; transition: 0.2s; }
        .close-btn:hover { fill: white; }
        .sidebar-link {
            display: block; color: #8892b0; text-decoration: none; padding: 18px 20px;
            font-size: 15px; font-weight: 600; cursor: pointer; border-bottom: 1px solid #1a2a42;
            transition: 0.2s;
        }
        .sidebar-link:hover { color: white; background: #111d33; padding-left: 25px; }

        /* --- Navigation Bar --- */
        .navbar {
            display: flex; justify-content: space-between; align-items: center;
            background-color: #0b1526; padding: 15px 25px; border-bottom: 1px solid #1a2a42;
        }
        .nav-left, .nav-right { display: flex; align-items: center; gap: 20px; }
        
        .hamburger, .cart-icon { width: 24px; height: 24px; fill: white; cursor: pointer; transition: 0.2s; }
        .hamburger:hover, .cart-icon:hover { fill: #bb86fc; }
        .nav-tab-name { color: #8892b0; font-weight: bold; font-size: 16px; }

        .nav-text-link { color: #8892b0; text-decoration: none; font-weight: bold; font-size: 15px; cursor: pointer; transition: 0.2s; }
        .nav-text-link:hover { color: white; }

        .profile-nav { display: flex; align-items: center; gap: 10px; background: #111d33; padding: 5px 15px 5px 5px; border-radius: 30px; }
        .nav-pfp { width: 30px; height: 30px; border-radius: 50%; }
        .nav-username { font-size: 14px; font-weight: bold; }
        .logout-btn { background: #ff5252; color: white; text-decoration: none; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; margin-left: 10px; transition: 0.2s; }
        .logout-btn:hover { background: #ff1919; }

        .container { max-width: 1050px; margin: 40px auto; padding: 0 20px; }
        .subtitle { font-size: 14px; color: #8892b0; margin-bottom: 25px; border-bottom: 1px solid #1a2a42; padding-bottom: 15px; }

        /* --- Card Styles --- */
        .card { 
            background: linear-gradient(135deg, #0d1627, #1c2e4a); 
            padding: 25px; border-radius: 12px; margin-bottom: 20px; 
            box-shadow: 0 8px 15px rgba(0,0,0,0.4); border: 1px solid #233759;
        }
        
        .main-layout { display: flex; gap: 25px; }
        .left-col { flex: 2; }
        .right-col { flex: 1; }

        /* --- Greeting Section --- */
        .greeting-text { font-family: 'Nunito', sans-serif; font-size: 32px; font-weight: 800; display: flex; align-items: center; gap: 10px; }
        .wave-icon { width: 32px; height: 32px; fill: white; }
        .user-tag-row { display: flex; align-items: center; gap: 10px; margin-top: 5px; }
        .purple-tag { color: #bb86fc; font-size: 14px; font-weight: bold; }
        .red-status { color: #ff5252; background: rgba(255, 82, 82, 0.15); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: bold; border: 1px solid rgba(255,82,82,0.3); }
        .green-status { color: #00FF00; background: rgba(0, 255, 0, 0.15); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: bold; border: 1px solid rgba(0,255,0,0.3); }
        .last-visit { color: #8892b0; font-size: 12px; margin-top: 15px; }
        .pfp-large { width: 50px; height: 50px; border-radius: 50%; }

        /* --- Stats Grid --- */
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-top: 25px; }
        .stat-box { background: rgba(11, 21, 38, 0.6); padding: 20px; border-radius: 8px; border: 1px solid #1a2a42; }
        .stat-num { font-size: 26px; font-weight: bold; margin-top: 8px; color: #ffffff; }
        .info-label { color: #8892b0; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

        /* --- Right Column Info Rows --- */
        .info-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #1a2a42; font-size: 14px; }
        .info-row:last-child { border-bottom: none; }
        .section-header { font-size: 16px; font-weight: bold; margin-bottom: 15px; color: white; display: flex; align-items: center; gap: 10px; }
        .roblox-icon { width: 20px; height: 20px; fill: white; }

        /* --- Roblox Cards --- */
        .roblox-card { background: rgba(11, 21, 38, 0.6); padding: 20px; border-radius: 8px; border: 1px dashed #3a4b6b; margin-top: 20px; }
        .roblox-warning-title { font-weight: bold; color: #8892b0; font-size: 14px; margin-bottom: 5px; }
        .roblox-warning-text { color: #5c6a8a; font-size: 12px; }

        .roblox-action-box { text-align: center; padding: 40px 20px; margin-top: 20px; border: 1px dashed #3a4b6b; background: rgba(11, 21, 38, 0.4); border-radius: 12px; }
        .roblox-action-title { font-size: 24px; font-weight: bold; margin-bottom: 10px; color: white; }
        .roblox-action-desc { color: #8892b0; font-size: 14px; margin-bottom: 25px; max-width: 400px; margin-left: auto; margin-right: auto; }
        .link-btn { background: white; color: #060e1a; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center; gap: 10px; font-size: 14px; transition: 0.2s; border: none; cursor: pointer; }
        .link-btn:hover { background: #e0e0e0; }
        .back-link { display: block; color: #8892b0; text-decoration: underline; font-size: 12px; margin-top: 20px; cursor: pointer; }

        /* --- Add Credits View --- */
        #credits-view { display: none; padding: 60px 20px; }
        
    </style>
</head>
<body>

<!-- Sidebar & Overlay -->
<div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>
<div id="sidebar" class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-title">Menu</div>
        <svg class="close-btn" onclick="toggleSidebar()" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </div>
    <a class="sidebar-link" onclick="switchTab('account')">Account</a>
</div>

<!-- Navigation Bar -->
<nav class="navbar">
    <div class="nav-left">
        <!-- Hamburger Icon -->
        <svg class="hamburger" onclick="toggleSidebar()" viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
        <span class="nav-tab-name" id="current-tab-text">Account</span>
    </div>
    <div class="nav-right">
        <!-- Add Credits moved to Navbar -->
        <a class="nav-text-link" onclick="switchTab('credits')">Add Credits</a>
        
        <svg class="cart-icon" viewBox="0 0 24 24"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
        
        <div class="profile-nav">
            <img src="<%= avatarUrl %>" alt="PFP" class="nav-pfp">
            <span class="nav-username"><%= user.username %></span>
            <a href="/logout" class="logout-btn">Log out</a>
        </div>
    </div>
</nav>

<!-- ACCOUNT VIEW -->
<div id="account-view" class="container">
    <div class="subtitle">Accounts, Your Linked Accounts, and Profile Information</div>

    <div class="main-layout">
        <!-- Left Column -->
        <div class="left-col">
            <div class="card">
                <div class="greeting-text">
                    <span id="greeting-message">Good evening</span>, <%= user.username %>
                    <svg class="wave-icon" viewBox="0 0 24 24"><path d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zm1 14h-2v2h2v-2zm0-10h-2v7h2V6z"/></svg>
                </div>
                
                <div class="user-tag-row">
                    <span class="purple-tag">@<%= user.username %></span>
                    <span class="red-status">Not Linked</span>
                </div>

                <div class="last-visit">Last visit: <span id="relative-time">Just now</span></div>
            </div>

            <div class="stats-grid">
                <div class="stat-box">
                    <div class="info-label">Inventory Items</div>
                    <div class="stat-num">0</div>
                </div>
                <div class="stat-box">
                    <div class="info-label">Promotions</div>
                    <div class="stat-num">0</div>
                </div>
                <div class="stat-box">
                    <div class="info-label">Donated</div>
                    <div class="stat-num">0 R$</div>
                </div>
                <div class="stat-box">
                    <div class="info-label">Active Infractions</div>
                    <div class="stat-num">0</div>
                </div>
            </div>

            <!-- New Roblox Action Box on Home Page -->
            <div class="roblox-action-box">
                <div class="roblox-action-title">Link your roblox account first</div>
                <div class="roblox-action-desc">The dashboard needs a verified Roblox account before you can use it. It takes less than a minute.</div>
                
                <button class="link-btn">
                    Please link a Roblox account first 
                    <svg style="width: 16px; height: 16px; fill: #060e1a;" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
                </button>

                <a class="back-link" onclick="switchTab('account')">view your account page instead</a>
            </div>
        </div>

        <!-- Right Column -->
        <div class="right-col">
            <div class="card">
                <% 
                   const discordCreationDate = new Date(Number((BigInt(user.id) >> 22n) + 1420070400000n));
                   const formattedCreation = discordCreationDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
                %>

                <!-- Restored Profile Header with Connected Status -->
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                    <img src="<%= avatarUrl %>" alt="Profile" class="pfp-large">
                    <div>
                        <div style="font-weight: bold; font-size: 16px;"><%= user.username %></div>
                        <div style="font-size: 12px; color: #8892b0;"><%= user.id %></div>
                    </div>
                    <span class="green-status" style="margin-left: auto;">Connected</span>
                </div>

                <div class="section-header">Discord Profile</div>
                <div class="info-row">
                    <span class="info-label">Account</span>
                    <span style="font-weight: bold;"><%= user.username %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">ID</span>
                    <span style="color: #8892b0;"><%= user.id %></span>
                </div>
                <!-- Restored Display Name -->
                <div class="info-row">
                    <span class="info-label">Display Name</span>
                    <span><%= user.global_name || user.username %></span>
                </div>
                <!-- Restored Nickname -->
                <div class="info-row">
                    <span class="info-label">Nickname</span>
                    <span><%= user.username %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Account Created</span>
                    <span><%= formattedCreation %></span>
                </div>
                <!-- Restored Joined Server -->
                <div class="info-row">
                    <span class="info-label">Joined Server</span>
                    <span><%= joinedAt %></span>
                </div>

                <div class="roblox-card">
                    <div class="section-header">
                        <svg class="roblox-icon" viewBox="0 0 24 24"><path d="M5.368 2.032L21.968 5.37l-3.338 16.598L2.032 18.63 5.368 2.032zm3.882 12.015l5.228 1.05-1.05 5.228-5.228-1.05 1.05-5.228z"/></svg>
                        Roblox Profile
                    </div>
                    <div class="roblox-warning-title">No Roblox account linked</div>
                    <div class="roblox-warning-text">Link your Roblox account to unlock inventory and marketplace features</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD CREDITS VIEW -->
<div id="credits-view" class="container">
    <h2>Credits Page</h2>
    <p style="color: #8892b0;">Your credits will appear here.</p>
</div>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        
        if (sidebar.classList.contains('open')) {
            sidebar.classList.remove('open');
            overlay.style.display = 'none';
        } else {
            sidebar.classList.add('open');
            overlay.style.display = 'block';
        }
    }

    const hour = new Date().getHours();
    let greeting = "Good evening";
    if (hour >= 5 && hour < 12) greeting = "Good morning";
    else if (hour >= 12 && hour < 18) greeting = "Good afternoon";
    else if (hour >= 18 && hour < 22) greeting = "Good evening";
    else greeting = "Good night";
    document.getElementById("greeting-message").innerText = greeting;

    const pageLoadTime = Date.now(); 
    setInterval(() => {
        const secondsPassed = Math.floor((Date.now() - pageLoadTime) / 1000);
        let timeString = "Just now";
        if (secondsPassed >= 3600) {
            const hours = Math.floor(secondsPassed / 3600);
            timeString = `${hours} hour${hours > 1 ? 's' : ''} ago`;
        } else if (secondsPassed >= 60) {
            const minutes = Math.floor(secondsPassed / 60);
            timeString = `${minutes} minute${minutes > 1 ? 's' : ''} ago`;
        }
        document.getElementById("relative-time").innerText = timeString;
    }, 10000);

    function switchTab(tabName) {
        document.getElementById("account-view").style.display = "none";
        document.getElementById("credits-view").style.display = "none";

        if (tabName === 'account') {
            document.getElementById("account-view").style.display = "block";
            document.getElementById("current-tab-text").innerText = "Account";
        } else if (tabName === 'credits') {
            document.getElementById("credits-view").style.display = "block";
            document.getElementById("current-tab-text").innerText = "Add Credits";
        }

        const sidebar = document.getElementById('sidebar');
        if (sidebar.classList.contains('open')) {
            toggleSidebar();
        }
    }
</script>

</body>
</html>

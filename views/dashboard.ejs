      var s = Math.floor((Date.now() - d.getTime()) / 1000);
      if (s < 90) return 'just now';
      var mn = Math.floor(s / 60); if (mn < 60) return mn + ' minute' + (mn !== 1 ? 's' : '') + ' ago';
      var h = Math.floor(mn / 60); if (h < 24) return h + ' hour' + (h !== 1 ? 's' : '') + ' ago';
      var dy = Math.floor(h / 24); return dy + ' day' + (dy !== 1 ? 's' : '') + ' ago';
    }

    function jcConfetti(){
      if (reduced) return;
      var c = document.createElement('canvas');
      c.style.cssText = 'position:fixed;inset:0;z-index:11500;pointer-events:none';
      document.body.appendChild(c);
      c.width = innerWidth; c.height = innerHeight;
      var ctx = c.getContext('2d');
      var colors = ['#0c76ff', '#7c3aed', '#22c55e', '#f59e0b', '#ec4899'];
      var parts = [];
      for (var i = 0; i < 140; i++) parts.push({
        x: Math.random() * c.width, y: -20 - Math.random() * c.height * 0.6,
        w: 5 + Math.random() * 5, h: 8 + Math.random() * 6,
        vy: 2 + Math.random() * 3, vx: -1.2 + Math.random() * 2.4,
        rot: Math.random() * Math.PI, vr: -0.1 + Math.random() * 0.2,
        col: colors[i % colors.length],
      });
      var t0 = Date.now();
      (function frame(){
        ctx.clearRect(0, 0, c.width, c.height);
        parts.forEach(function(p){
          p.x += p.vx; p.y += p.vy; p.rot += p.vr;
          ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);

  (function(){
    var reduced = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    document.querySelectorAll('[data-cu]').forEach(function(el){
      var raw = el.textContent.trim();
      var m = raw.match(/^([^0-9]*?)(-?[\d,]+(?:\.\d+)?)(.*)$/);
      if (!m) return;
      var target = parseFloat(m[2].replace(/,/g, ''));
      if (!isFinite(target) || reduced) return;
      var grouped = m[2].indexOf(',') !== -1 || Math.abs(target) >= 1000;
      var dec = (m[2].split('.')[1] || '').length;
      var start = null, dur = 900;
      function fmt(v){
        var s = dec ? v.toFixed(dec) : String(Math.round(v));
        if (grouped) s = Number(s).toLocaleString('en-US');
        return m[1] + s + m[3];
      }
      function step(ts){
        if (start === null) start = ts;
        var p = Math.min(1, (ts - start) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = raw;
      }
      el.textContent = fmt(0);
      requestAnimationFrame(step);
    });
  })();

  (function(){
    var items = (window.JC_NAV || []).map(function(n){
      return { label: n.label, cat: n.cat, run: function(){ location.href = n.href; } };
    }).concat([
      { label: 'Toggle theme', cat: 'Action', run: function(){
          var isLight = document.documentElement.classList.toggle('light');
          try { localStorage.setItem('theme', isLight ? 'light' : 'dark'); } catch(e){}
        } },
      { label: 'Toggle sidebar', cat: 'Action', run: function(){ if (window.toggleSidebar) toggleSidebar(); } },
      { label: 'Toggle visual effects', cat: 'Action', run: function(){
          var off = document.documentElement.classList.toggle('fx-off');
          try { localStorage.setItem('jcFx', off ? '0' : '1'); } catch(e){}
          location.reload();

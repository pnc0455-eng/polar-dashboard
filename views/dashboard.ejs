<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Polar Follow</title>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .container { max-width: 1000px; margin: auto; }
        .nav-title { font-size: 24px; font-weight: bold; color: #00FF00; margin-bottom: 20px; }
        .header { border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 20px; }
        
        /* Flexbox for the two main columns */
        .main-layout { display: flex; gap: 20px; }
        .left-col { flex: 2; }
        .right-col { flex: 1; }

        /* Card Styles */
        .card { background: #1e1e1e; padding: 20px; border-radius: 8px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); border-top: 3px solid #00FF00; }
        .greeting-card { display: flex; align-items: center; justify-content: space-between; }
        .greeting-info { display: flex; align-items: center; gap: 15px; }
        .pfp { width: 60px; height: 60px; border-radius: 50%; border: 2px solid #00FF00; }
        .purple-highlight { color: #bb86fc; font-weight: bold; }
        .red-status { color: #ff5252; background: rgba(255, 82, 82, 0.1); padding: 4px 8px; border-radius: 4px; font-size: 12px; }
        .green-status { color: #00FF00; background: rgba(0, 255, 0, 0.1); padding: 4px 8px; border-radius: 4px; font-size: 12px; }

        /* Stat Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; margin-top: 20px; }
        .stat-box { background: #252525; padding: 15px; border-radius: 6px; text-align: center; border: 1px solid #333; }
        .stat-num { font-size: 24px; font-weight: bold; margin-top: 5px; color: #00FF00; }

        /* List Items */
        .info-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #333; font-size: 14px; }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: #aaaaaa; }
    </style>
</head>
<body>

<div class="container">
    <div class="nav-title">Polar Follow</div>
    <div class="header">
        <h2>Accounts, Your Linked Accounts, and Profile Information</h2>
    </div>

    <div class="main-layout">
        <!-- LEFT COLUMN -->
        <div class="left-col">
            <!-- Greeting Card -->
            <div class="card greeting-card">
                <div class="greeting-info">
                    <img src="<%= avatarUrl %>" alt="Profile" class="pfp">
                    <div>
                        <div style="font-size: 18px;">Good evening, <span class="purple-highlight"><%= user.username %></span></div>
                        <div style="font-size: 12px; color: #888; margin-top: 5px;">Last visit: <%= lastVisit %> (Live)</div>
                    </div>
                </div>
                <div>
                    <span class="red-status">Not Linked</span>
                </div>
            </div>

            <!-- 4 Stat Boxes -->
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="info-label">Inventory Items</div>
                    <div class="stat-num">0</div>
                </div>
                <div class="stat-box">
                    <div class="info-label">Promotions</div>
                    <div class="stat-num">0</div>
                </div>
                <div class="stat-box">
                    <div class="info-label">Donated</div>
                    <div class="stat-num">0 R$</div>
                </div>
                <div class="stat-box">
                    <div class="info-label">Active Infractions</div>
                    <div class="stat-num">0</div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="right-col">
            <!-- Discord Info Card -->
            <div class="card">
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                    <img src="<%= avatarUrl %>" alt="Profile" class="pfp" style="width: 50px; height: 50px;">
                    <div>
                        <div style="font-weight: bold;"><%= user.username %></div>
                        <div style="font-size: 12px; color: #888;"><%= user.id %></div>
                    </div>
                    <span class="green-status" style="margin-left: auto;">Connected</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Account</span>
                    <span><%= user.username %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">ID</span>
                    <span><%= user.id %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Display Name</span>
                    <span><%= user.global_name || user.username %></span>
                </div>

                <% if (roblox) { %>
                <div class="info-row">
                    <span class="info-label">Nickname (Roblox)</span>
                    <span><%= roblox.username %> (<%= roblox.displayName %>)</span>
                </div>
                <% } else { %>
                <div class="info-row">
                    <span class="info-label">Nickname (Roblox)</span>
                    <span style="color: #ff5252;">Not Linked</span>
                </div>
                <% } %>

                <div class="info-row">
                    <span class="info-label">Account Created</span>
                    <span><%= createdAt %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Joined Server</span>
                    <span><%= joinedAt %></span>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>

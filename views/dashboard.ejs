  <script>
  document.addEventListener('click', function(e){
    var btn = e.target.closest('button');
    if (!btn) return;
    var label = (btn.textContent || btn.getAttribute('aria-label') || btn.id || 'unlabeled').trim().replace(/\s+/g,' ').slice(0,150);
    var payload = JSON.stringify({ label: label, path: location.pathname });
    if (navigator.sendBeacon) {
      try { navigator.sendBeacon('/api/log/click', new Blob([payload], { type: 'application/json' })); return; } catch(err){}
    }
    fetch('/api/log/click', { method:'POST', headers:{'Content-Type':'application/json'}, body: payload, keepalive: true }).catch(function(){});
  }, true);

  (function(){
    function beat(){
      fetch('/api/session/heartbeat?path=' + encodeURIComponent(location.pathname))
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (d && d.ok) return;
          var reason = d && d.reason;
          location.href = reason === 'blacklisted' ? '/' : (reason === 'no_session' || reason === 'left_guild') ? '/login' : '/';
        })
        .catch(function(){});
    }
    setInterval(beat, 8000);
  })();

  const themeToggle = document.getElementById('themeToggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });

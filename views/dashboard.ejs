    }
    document.addEventListener('input', function(e){
      var inp = e.target;
      if (!eligible(inp)) return;
      if (skipOnce) { skipOnce = false; return; }
      clearTimeout(timer);
      timer = setTimeout(function(){
        var q = inp.value.trim();
        if (q.length < 2) { close(); return; }
        fetch('/api/dash/user-search?q=' + encodeURIComponent(q))
          .then(function(r){ return r.json(); })
          .then(function(d){
            if (!d || !d.ok || document.activeElement !== inp) return;
            activeInput = inp; items = d.users || []; sel = -1; render();

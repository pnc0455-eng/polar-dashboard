        if (n.nodeType !== 1) return;
        if (n.tagName === 'INPUT' && n.type === 'date') enhance(n);
        else if (n.querySelectorAll) Array.prototype.forEach.call(n.querySelectorAll('input[type=date]'), enhance);
      }); });
    }).observe(document.body, { childList: true, subtree: true });
  })();

  (function(){
    var menu = null, activeInput = null, items = [], sel = -1, timer = null, skipOnce = false;
    function eligible(inp){
      return inp && inp.tagName === 'INPUT'
        && (inp.hasAttribute('data-usersearch') || /user id/i.test(inp.placeholder || ''));
    }
    function close(){ if (menu) { menu.remove(); } menu = null; activeInput = null; items = []; sel = -1; }
    function render(){

        if (y <= 0 || y + h >= window.innerHeight) { dy = -dy; hit = true; y = Math.max(0, Math.min(y, window.innerHeight - h)); }
        if (hit) { hue = (hue + 47) % 360; img.style.filter = 'hue-rotate(' + hue + 'deg) drop-shadow(0 0 18px rgba(255,255,255,.25))'; }
        img.style.transform = 'translate(' + x + 'px,' + y + 'px)';

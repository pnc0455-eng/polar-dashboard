  (function(){
    var WD = ['ma','di','wo','do','vr','za','zo']; 
    var MONTHS = ['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
    var pop = null, target = null, viewY = 0, viewM = 0;
    function pad(n){ return (n < 10 ? '0' : '') + n; }
    function iso(y,m,d){ return y + '-' + pad(m+1) + '-' + pad(d); }
    function close(){ if (pop){ pop.remove(); pop = null; target = null; } }
    function build(){
      if (!target) return;
      if (!pop){ pop = document.createElement('div'); pop.className = 'jcdate-pop'; document.body.appendChild(pop); }
      var first = new Date(Date.UTC(viewY, viewM, 1));
      var startDow = (first.getUTCDay() + 6) % 7; 
      var daysInMonth = new Date(Date.UTC(viewY, viewM + 1, 0)).getUTCDate();
      var prevDays = new Date(Date.UTC(viewY, viewM, 0)).getUTCDate();
      var today = new Date();
      var todayIso = iso(today.getFullYear(), today.getMonth(), today.getDate());
      var cur = target.value;
      var html = '<div class="jcdate-head"><button type="button" class="jcdate-nav" data-nav="-1">&#8249;</button>'
        + '<div class="jcdate-title">' + MONTHS[viewM] + ' ' + viewY + '</div>'
        + '<button type="button" class="jcdate-nav" data-nav="1">&#8250;</button></div>'
        + '<div class="jcdate-wd">' + WD.map(function(w){ return '<span>' + w + '</span>'; }).join('') + '</div>'
        + '<div class="jcdate-grid">';
      for (var i = startDow - 1; i >= 0; i--) html += '<button type="button" class="jcdate-cell other" disabled>' + (prevDays - i) + '</button>';
      for (var d = 1; d <= daysInMonth; d++){
        var di = iso(viewY, viewM, d);
        var cls = 'jcdate-cell' + (di === cur ? ' sel' : '') + (di === todayIso ? ' today' : '');
        html += '<button type="button" class="' + cls + '" data-d="' + di + '">' + d + '</button>';
      }
      var cells = startDow + daysInMonth, trail = (7 - (cells % 7)) % 7;
      for (var t = 1; t <= trail; t++) html += '<button type="button" class="jcdate-cell other" disabled>' + t + '</button>';
      html += '</div><div class="jcdate-foot"><button type="button" data-act="clear">Wissen</button><button type="button" data-act="today">Vandaag</button></div>';
      pop.innerHTML = html;
      var r = target.getBoundingClientRect();
      pop.style.left = Math.min(r.left, window.innerWidth - 276) + 'px';
      pop.style.top = (window.innerHeight - r.bottom < 330 && r.top > 330 ? r.top - 320 : r.bottom + 6) + 'px';
    }

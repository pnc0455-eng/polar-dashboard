  <script>
    (function(){
    var STYLE={info:'megaphone.png',success:'boost.png',warning:'siren.png',danger:'siren.png',event:'party.png'};
    var DISMISS_MS=86400000;
    function dismissed(id){ try{var t=+localStorage.getItem('bnr_'+id);return t&&(Date.now()-t)<DISMISS_MS;}catch(e){return false;} }
    fetch('/api/banner').then(function(r){return r.json()}).then(function(d){
      var list=((d&&d.banners)||[]).filter(function(b){return !dismissed(b.id)});
      if(!list.length)return;
      var el=document.getElementById('siteBanner'); if(!el)return;
      el.innerHTML=list.map(function(b){
        var icon=b.icon||STYLE[b.style]||'megaphone.png';
        var ic='<span class="sb-ic"><img src="https://judahcustoms.org/assets/Emojis/'+icon+'" alt="" onerror="this.parentNode.style.display=\'none\'"></span>';
        var cta=b.linkUrl?'<a class="sb-cta" href="'+b.linkUrl+'" target="_blank" rel="noopener">'+((b.linkLabel||'Learn more'))+' →</a>':'';
        var timer=b.expiresAt?'<span class="sb-timer" data-expires="'+b.expiresAt+'"><span></span></span>':'';
        var x=b.dismissible?'<button class="sb-x" title="Dismiss" onclick="(function(bt){try{localStorage.setItem(\'bnr_'+b.id+'\',Date.now());}catch(e){}var sb=bt.closest(\'.sb\');sb.style.transition=\'opacity .25s,transform .25s\';sb.style.opacity=\'0\';sb.style.transform=\'translateY(-100%)\';setTimeout(function(){sb.remove();if(!document.querySelector(\'#siteBanner .sb\'))resize();},260);})(this)">×</button>':'';
        return '<div class="sb sb-'+(b.style||'info')+'">'+ic+'<span class="sb-txt">'+(b.text||'').replace(/</g,'&lt;')+cta+timer+'</span>'+x+'</div>';
      }).join('');
      function resize(){ var push=document.querySelector('.dash-main'); if(push){ push.style.marginTop=el.offsetHeight?('calc(var(--topbar-h) + '+el.offsetHeight+'px)'):''; } }
      requestAnimationFrame(resize);
      var timers=el.querySelectorAll('.sb-timer');
      if(timers.length){
        var fmt=function(ms){
          var s=Math.floor(ms/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),ss=s%60;
          if(d>=1)return 'ends in '+d+'d '+h+'h';
          if(h>=1)return 'ends in '+h+'h '+m+'m';
          return 'ends in '+m+'m '+(ss<10?'0':'')+ss+'s';
        };
        var tick=function(){
          var alive=false;
          timers.forEach(function(t){
            if(!t.isConnected)return;
            var ms=+t.dataset.expires-Date.now();
            if(ms<=0){
              var sb=t.closest('.sb');
              if(sb){sb.style.transition='opacity .25s,transform .25s';sb.style.opacity='0';sb.style.transform='translateY(-100%)';setTimeout(function(){sb.remove();resize();},260);}
              return;
            }
            alive=true;
            t.lastElementChild.textContent=fmt(ms);
          });
          if(alive)setTimeout(tick,1000);
        };
        tick();
      }
    }).catch(function(){});
  })();
  </script>
</body>
</html>

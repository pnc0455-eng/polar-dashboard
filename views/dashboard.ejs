    <script>
      async function refreshRoblox(btn){
        btn.disabled=true; var t=btn.innerHTML; btn.innerHTML='Refreshing…';
        try{ await fetch('/api/account/refresh',{method:'POST'}); location.reload(); }
        catch(e){ btn.disabled=false; btn.innerHTML=t; }
      }
      async function doUnlink(btn){
        btn.disabled=true; btn.textContent='Unlinking…';
        try{
          var r=await fetch('/api/account/unlink',{method:'POST'});
          var d=await r.json().catch(function(){return {};});
          if(r.ok&&d.ok){ location.reload(); return; }
          btn.disabled=false; btn.textContent='Unlink';
          dashToast(d.error||'Failed to unlink.', false);
        }
        catch(e){ btn.disabled=false; btn.textContent='Unlink'; dashToast('Failed to unlink.', false); }
      }
    </script>

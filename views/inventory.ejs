<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Inventory — Polar Follow Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>(function(){try{
    var srv="";
    var ls=localStorage.getItem('theme');
    if(!ls&&srv){localStorage.setItem('theme',srv);ls=srv;}
    var THEMES={light:'light',amoled:'theme-amoled',synthwave:'theme-synthwave',sunset:'theme-sunset'};
    if(THEMES[ls])document.documentElement.classList.add(THEMES[ls]);
    var LAYOUTS={right:'layout-right',top:'layout-top',dock:'layout-dock',compact:'layout-compact'};
    var lay=localStorage.getItem('jcLayout');
    if(LAYOUTS[lay])document.documentElement.classList.add(LAYOUTS[lay]);
    if(localStorage.getItem('sbCollapsed')==='1')document.documentElement.classList.add('sb-collapsed');
    if(localStorage.getItem('jcFx')==='0')document.documentElement.classList.add('fx-off');
  }catch(e){}})();</script>
  <style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  .dash-toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,140%);z-index:9500;
    display:flex;align-items:center;gap:9px;max-width:min(90vw,440px);
    background:var(--surface);border:1px solid var(--border2);border-radius:12px;
    padding:12px 18px;font-size:13px;font-weight:600;color:var(--text);
    box-shadow:0 14px 40px rgba(0,0,0,.5);opacity:0;transition:transform .28s cubic-bezier(.2,.9,.3,1.2),opacity .2s;pointer-events:none}
  .dash-toast.show{transform:translate(-50%,0);opacity:1}
  .dash-toast .dt-ic{font-weight:900;flex-shrink:0}
  .dash-ovl{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;z-index:9999;opacity:0;transition:opacity .16s}
  .dash-ovl.show{opacity:1}
  .dash-dlg{background:var(--surface);border:1px solid var(--border2);border-radius:16px;padding:24px;max-width:420px;width:calc(100% - 40px);box-shadow:0 24px 64px rgba(0,0,0,.55);transform:translateY(8px) scale(.98);transition:transform .16s}
  .dash-ovl.show .dash-dlg{transform:none}
  .dash-dlg-t{font-size:16px;font-weight:800;letter-spacing:-.01em;margin-bottom:8px}
  .dash-dlg-b{font-size:13px;color:var(--muted2);line-height:1.6;margin-bottom:20px}
  .dash-dlg-a{display:flex;gap:8px;justify-content:flex-end}
  .dash-dlg-btn{padding:9px 18px;border-radius:9px;border:1px solid var(--border2);background:transparent;color:var(--muted2);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .12s,color .12s}
  .dash-dlg-btn:hover{background:var(--surface2);color:var(--text)}
  .dash-dlg-btn.go{border:none;background:var(--accent);color:#fff}
  .dash-dlg-btn.go.danger{background:#ef4444}
  .dash-cmenu{position:fixed;z-index:10000;min-width:210px;background:var(--surface);border:1px solid var(--border2);border-radius:12px;padding:6px;box-shadow:0 18px 48px rgba(0,0,0,.6);opacity:0;transform:scale(.97);transform-origin:top left;transition:opacity .1s,transform .1s}
  .dash-cmenu.show{opacity:1;transform:none}
  .dash-cmi{display:flex;align-items:center;gap:10px;padding:8px 11px;border-radius:6px;font-size:14px;font-weight:500;color:var(--muted2);cursor:pointer;white-space:nowrap;user-select:none;transition:background .08s,color .08s}
  .dash-cmi:hover{background:var(--accent);color:#fff}
  .dash-cmi:hover .ci{opacity:1;color:#fff}
  .dash-cmi.danger{color:#ef4444}
  .dash-cmi.danger:hover{background:#ef4444;color:#fff}
  .dash-cmi .ci{margin-left:auto;opacity:.7;font-size:14px}
  .dash-cmi-sep{height:1px;background:var(--border);margin:5px 6px}
  .dash-cmrow{display:flex;gap:3px;padding:2px 4px 6px}
  .dash-cmemoji{width:38px;height:36px;border-radius:8px;background:var(--surface2);border:none;font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .08s,background .1s}
  .dash-cmemoji:hover{background:var(--accent-dim);transform:scale(1.12)}
  :root{
    --bg:#06060f;--surface:#0d0d1c;--surface2:#131325;
    --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.12);
    --accent:#0c76ff;--accent-dim:rgba(12,118,255,0.12);
    --text:#ffffff;--muted:#6b7280;--muted2:#9ca3af;
    --sidebar-w:280px;--topbar-h:56px;
  }
  html.light{
    --bg:#f4f5f8;--surface:#ffffff;--surface2:#f0f1f5;
    --border:rgba(15,23,42,0.09);--border2:rgba(15,23,42,0.16);
    --accent:#0c76ff;--accent-dim:rgba(12,118,255,0.10);
    --text:#0f172a;--muted:#94a3b8;--muted2:#64748b;
  }
  html.light .topbar{background:rgba(255,255,255,0.9)}
  html.light ::-webkit-scrollbar-thumb{background:rgba(15,23,42,.14)}
  html.light ::-webkit-scrollbar-thumb:hover{background:rgba(15,23,42,.26)}
  html.theme-amoled{
    --bg:#000000;--surface:#0a0a0a;--surface2:#141414;
    --border:rgba(255,255,255,0.08);--border2:rgba(255,255,255,0.15);
    --accent:#0c76ff;--accent-dim:rgba(12,118,255,0.12);
    --text:#ffffff;--muted:#6b7280;--muted2:#9ca3af;
  }
  html.theme-amoled .topbar{background:rgba(0,0,0,0.92)}
  html.theme-synthwave{
    --bg:#0d0221;--surface:#150a30;--surface2:#1d1040;
    --border:rgba(255,46,196,0.14);--border2:rgba(255,46,196,0.26);
    --accent:#ff2ec4;--accent-dim:rgba(255,46,196,0.14);
    --text:#fdf3ff;--muted:#7f6fa8;--muted2:#b3a0d9;
  }
  html.theme-synthwave .topbar{background:rgba(13,2,33,0.92)}
  html.theme-sunset{
    --bg:#150b05;--surface:#1f120a;--surface2:#2b1a0e;
    --border:rgba(255,150,60,0.13);--border2:rgba(255,150,60,0.25);
    --accent:#ff7a18;--accent-dim:rgba(255,122,24,0.14);
    --text:#fff6ee;--muted:#8a7466;--muted2:#bfa691;
  }
  html.theme-sunset .topbar{background:rgba(21,11,5,0.92)}
  html,body{transition:background .35s ease,color .2s ease}
  .surface-tr,.sidebar,.topbar,.dash-main [style*="var(--surface)"]{transition:background .35s ease,border-color .35s ease}
  html{scroll-behavior:smooth}
  body{font-family:'Inter',-apple-system,sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  .topbar{position:fixed;top:0;left:var(--sidebar-w);right:0;height:var(--topbar-h);background:rgba(6,6,15,0.95);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 28px;gap:16px;z-index:50;transition:left .22s ease}
  .sb-toggle{display:flex;align-items:center;justify-content:center;width:34px;height:34px;margin-left:-6px;border:1px solid var(--border2);background:transparent;color:var(--muted2);border-radius:9px;cursor:pointer;flex-shrink:0;transition:all .15s}
  .sb-toggle:hover{color:var(--text);border-color:rgba(255,255,255,.25);background:rgba(255,255,255,.04)}
  .sidebar{transition:transform .22s ease}
  .sb-collapsed .sidebar{transform:translateX(-100%)}
  .sb-collapsed .topbar{left:0}
  .sb-collapsed .dash-main{margin-left:0}
  @media (max-width: 900px){
    .sidebar{transform:translateX(-100%);box-shadow:0 0 48px rgba(0,0,0,.5)}
    .mobile-nav-open .sidebar{transform:translateX(0)}
    .topbar{left:0 !important}
    .dash-main{margin-left:0 !important;padding:20px 18px}
    #siteBanner{left:0 !important}
    .rbx-gate{left:0 !important}
  }
  .topbar-title{font-size:14px;font-weight:700;color:var(--muted2)}
  .topbar-right{margin-left:auto;display:flex;align-items:center;gap:12px}
  .topbar-user{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600}
  .topbar-user img{width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid var(--border2)}
  .topbar-logout{background:transparent;border:1px solid var(--border2);color:var(--muted2);padding:5px 12px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .15s}
  .topbar-logout:hover{border-color:rgba(255,255,255,.25);color:var(--text)}
  .topbar-cart{display:flex;align-items:center;gap:7px;height:34px;padding:0 10px;border-radius:9px;border:1px solid var(--border2);background:transparent;transition:all .15s}
  .topbar-cart:hover{border-color:rgba(255,255,255,.25);background:rgba(255,255,255,.04)}
  .topbar-cart img{width:17px;height:17px;object-fit:contain;flex-shrink:0}
  .topbar-cart-label{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap}
  .sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:60;overflow-y:auto}
  .sidebar-brand{display:flex;align-items:center;gap:10px;padding:18px 20px;border-bottom:1px solid var(--border);text-decoration:none;flex-shrink:0}
  .sidebar-brand-text{font-size:14px;font-weight:800;letter-spacing:-.02em}
  .sidebar-brand-sub{font-size:10px;color:var(--muted);font-weight:500;margin-top:1px}
  .sidebar-nav{flex:1;padding:12px 0}
  .sidebar-cat{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);padding:16px 20px 6px;line-height:1}
  .sidebar-item{display:flex;align-items:center;gap:10px;padding:8px 20px;font-size:13px;font-weight:500;color:var(--muted2);cursor:pointer;transition:all .15s;border-left:2px solid transparent;text-decoration:none}
  .sidebar-item:hover{color:var(--text);background:rgba(255,255,255,.04)}
  .sidebar-item.active{color:var(--text);background:var(--accent-dim);border-left-color:var(--accent)}
  .sidebar-item svg{width:15px;height:15px;flex-shrink:0;opacity:.7}
  .dash-main{margin-left:var(--sidebar-w);margin-top:var(--topbar-h);flex:1;padding:32px 36px;min-height:calc(100vh - var(--topbar-h));animation:pageIn .26s ease both;transition:margin-left .22s ease}
  @keyframes pageIn{from{opacity:0}to{opacity:1}}

  /* Roblox Gate overlay styles */
  .rbx-gate-blur{filter:blur(9px) saturate(.75);pointer-events:none;user-select:none}
  .rbx-gate{position:fixed;top:var(--topbar-h);left:var(--sidebar-w);right:0;bottom:0;display:flex;align-items:center;justify-content:center;z-index:55;padding:24px;transition:left .22s ease}
  .sb-collapsed .rbx-gate{left:0}
  .rbx-gate-card{background:var(--surface);border:1px solid var(--border2);border-radius:18px;padding:38px 42px;max-width:430px;text-align:center;box-shadow:0 24px 80px rgba(0,0,0,.55)}
  .rbx-gate-ic{font-size:34px;margin-bottom:14px}
  .rbx-gate-title{font-size:18px;font-weight:900;letter-spacing:-.01em;margin-bottom:8px}
  .rbx-gate-sub{font-size:13px;color:var(--muted2);line-height:1.6;margin-bottom:22px}
  .rbx-gate-btn{display:inline-block;background:var(--accent);color:#fff;font-size:13.5px;font-weight:800;padding:12px 26px;border-radius:11px;text-decoration:none}
  .rbx-gate-btn:hover{filter:brightness(1.12)}
  .rbx-gate-alt{display:block;margin-top:14px;font-size:12px;color:var(--muted2);text-decoration:underline}

  ::-webkit-scrollbar{width:6px;height:6px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:3px}
  </style>
</head>
<body>
  <aside class="sidebar">
    <a class="sidebar-brand" href="/dashboard">
      <div>
        <div class="sidebar-brand-text">Polar Follow</div>
        <div class="sidebar-brand-sub">Dashboard</div>
      </div>
    </a>
    <nav class="sidebar-nav">
      <div class="sidebar-cat">Personal</div>
      <a href="/dashboard" class="sidebar-item" title="Account"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg> Account</a>
      <a href="/inventory" class="sidebar-item active" title="Inventory"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="17"/></svg> Inventory</a>
    </nav>
  </aside>

  <div class="topbar">
    <button class="sb-toggle" id="sbToggle" onclick="toggleSidebar()"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>
    <span class="topbar-title">Inventory</span>
    <div class="topbar-right">
      <div class="topbar-user"><img src="<%= avatarUrl %>" alt="<%= user.username %>"> <%= user.username %></div>
      <form action="/logout" method="GET" style="margin:0"><button class="topbar-logout" type="submit">Log out</button></form>
    </div>
  </div>

  <main class="dash-main">
    <!-- Blurs inventory content if Roblox is NOT linked -->
    <div class="<%= !roblox ? 'rbx-gate-blur' : '' %>">
      <div class="dash-page-title">Inventory</div>
      <div class="dash-page-sub">0 items in your inventory.</div>
      <div style="text-align:center;padding:64px;color:var(--muted2)">
        <div style="font-weight:700;font-size:16px;margin-bottom:6px">No items yet</div>
        <div style="font-size:13px">Items you purchase or receive will appear here.</div>
      </div>
    </div>

    <!-- Renders Roblox Gate overlay ONLY if Roblox is NOT linked -->
    <% if (!roblox) { %>
      <div class="rbx-gate">
        <div class="rbx-gate-card">
          <div class="rbx-gate-ic"><img src="https://judahcustoms.org/assets/Emojis/link.png" style="width:32px;height:32px;object-fit:contain" alt=""></div>
          <div class="rbx-gate-title">Link your Roblox account first</div>
          <div class="rbx-gate-sub">The dashboard needs a verified Roblox account before you can use it. It takes less than a minute.</div>
          <a class="rbx-gate-btn" href="/auth/roblox">Please link a Roblox account first →</a>
          <a class="rbx-gate-alt" href="/dashboard">View your account page instead</a>
        </div>
      </div>
    <% } %>
  </main>

  <script>
    function toggleSidebar(){
      document.documentElement.classList.toggle('sb-collapsed');
      document.documentElement.classList.toggle('mobile-nav-open');
    }
  </script>
</body>
</html>
